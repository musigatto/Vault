views:
  - type: table
    name: Temas
    filters:
      and:
        - tipo == "tema"
    order:
      - numero
      - file.name
      - bloque
      - file.mtime
    columnSize:
      note.numero: -19
      file.name: 506
  - type: table
    name: Por bloques
    filters:
      and:
        - tipo == "tema"
    groupBy:
      property: bloque
      direction: ASC
    order:
      - file.name
      - numero
      - file.mtime
  - type: table
    name: Revisar Tema 25
    filters:
      and:
        - tipo == "alternativa"
        - numero == 25
    order:
      - file.name
      - numero
      - estado
      - file.mtime
