{
	"nodes":[
		{"id":"title","type":"text","text":"Module 04 — Network Perimeter Security\nFirewall → IDS/IPS → Router/Switch → SDP","x":-560,"y":-1150,"width":360,"height":60,"color":"5"},
		{"id":"fw_title","type":"text","text":"Firewall Technology Stack","x":-1350,"y":-920,"width":420,"height":50,"color":"6"},
		{"id":"fw1","type":"text","text":"1 Packet Filtering  (L3)\nheader rules: src/dst IP+port\ncheap, low-latency, most routers","x":-1500,"y":-790,"width":310,"height":110,"color":"2"},
		{"id":"fw2","type":"text","text":"2 Circuit-Level Gateway\nsession layer · tracks handshake\nhides internal IPs","x":-1140,"y":-790,"width":310,"height":110,"color":"2"},
		{"id":"fw3","type":"text","text":"3 Application-Level Gateway\nproxy per service · app layer\nrenews connections","x":-780,"y":-790,"width":310,"height":110,"color":"2"},
		{"id":"fw4","type":"text","text":"4 Stateful Multilayer\ninspects headers + app data\nremembers past packets","x":-420,"y":-790,"width":310,"height":110,"color":"3"},
		{"id":"topo_title","type":"text","text":"Firewall Topologies","x":-1350,"y":-470,"width":420,"height":50,"color":"6"},
		{"id":"topo1","type":"text","text":"Bastion Host\nhardened, most exposed,\napplication/circuit proxy","x":-1500,"y":-340,"width":300,"height":110,"color":"2"},
		{"id":"topo2","type":"text","text":"Screened Subnet (DMZ)\ntriple-homed FW · perimeter net\nweb/FTP in DMZ","x":-1140,"y":-340,"width":300,"height":110,"color":"2"},
		{"id":"topo3","type":"text","text":"Multi-/Dual-Homed\nmulti-interface FW\ndual: routing disabled","x":-780,"y":-340,"width":300,"height":110,"color":"2"},
		{"id":"phase_title","type":"text","text":"Implementation Phases (LO06)","x":-1350,"y":-10,"width":420,"height":50,"color":"6"},
		{"id":"ph1","type":"text","text":"Plan\npolicy, ruleset, black/whitelist","x":-1500,"y":120,"width":250,"height":90,"color":"2"},
		{"id":"ph2","type":"text","text":"Configure\nNAT · ports · logging/alerting","x":-1210,"y":120,"width":250,"height":90,"color":"2"},
		{"id":"ph3","type":"text","text":"Test\nvalidate rules, analyze logs","x":-920,"y":120,"width":250,"height":90,"color":"2"},
		{"id":"ph4","type":"text","text":"Deploy\nphysical placement, connect","x":-630,"y":120,"width":250,"height":90,"color":"2"},
		{"id":"ph5","type":"text","text":"Manage/Maintain\nanalyzer tools, updates","x":-340,"y":120,"width":250,"height":90,"color":"2"},
		{"id":"ids_title","type":"text","text":"IDS: Alert Process + Deployment (LO11/12)","x":160,"y":-920,"width":500,"height":50,"color":"6"},
		{"id":"ids0","type":"text","text":"1 Install signatures\n2 Sensors gather data","x":120,"y":-790,"width":280,"height":90,"color":"1"},
		{"id":"ids1","type":"text","text":"3 Alert message sent\n(signature match / deviation)","x":440,"y":-790,"width":280,"height":90,"color":"1"},
		{"id":"ids2","type":"text","text":"4 IDS responds\npop-up · email · sound · mobile /\nauto countermeasure","x":760,"y":-790,"width":280,"height":90,"color":"1"},
		{"id":"ids3","type":"text","text":"5 Admin assesses damage\n6 Escalation · 7 Log+review","x":1080,"y":-790,"width":280,"height":90,"color":"1"},
		{"id":"dl_title","type":"text","text":"Deployment Levels","x":160,"y":-470,"width":500,"height":50,"color":"6"},
		{"id":"L1","type":"text","text":"L1 outside firewall\nleast-sensitive · log only, no alerts","x":120,"y":-340,"width":290,"height":80,"color":"4"},
		{"id":"L2","type":"text","text":"L2 DMZ behind ext FW\nFW-bypass · web/FTP · low-mod","x":450,"y":-340,"width":290,"height":80,"color":"4"},
		{"id":"L3","type":"text","text":"L3 backbone / internal\nbypass internal FW · med-high","x":780,"y":-340,"width":290,"height":80,"color":"4"},
		{"id":"L4","type":"text","text":"L4 critical subnets/hosts\nhigh-impact · sensitive systems","x":1110,"y":-340,"width":290,"height":80,"color":"4"},
		{"id":"fp_title","type":"text","text":"False Pos/Neg (LO13)","x":160,"y":-160,"width":500,"height":50,"color":"6"},
		{"id":"fp1","type":"text","text":"4 alert types:\nTP att·alert · FP no-att·alert\nFN att·no-alert(most danger) · TN no-att·no-alert","x":120,"y":-30,"width":430,"height":100,"color":"1"},
		{"id":"fp2","type":"text","text":"FP rate=FP/(FP+TN)\nFN rate=FN/(FN+TP)\nFix FN: IDS behind VPN/SSL term","x":600,"y":-30,"width":430,"height":100,"color":"3"},
		{"id":"sdp_title","type":"text","text":"SDP Zero-Trust (LO17)","x":1500,"y":-920,"width":500,"height":50,"color":"6"},
		{"id":"sdp1","type":"text","text":"Black Cloud (CSA) · \"Never trust,\nalways verify\" · dynamic FW (deny all)\nSPA · MFA · micro-segmentation","x":1320,"y":-790,"width":360,"height":110,"color":"3"},
		{"id":"sdp2","type":"text","text":"Client (initiating host)\n→ SPA packet w/ HMAC-OTP","x":1320,"y":-620,"width":360,"height":80,"color":"2"},
		{"id":"sdp3","type":"text","text":"Controller\nauth point: policy → grant access\npicks authorized gateways","x":1320,"y":-500,"width":360,"height":80,"color":"2"},
		{"id":"sdp4","type":"text","text":"Gateway (accepting host)\nonly at controller request ·\nmutual VPN (encrypted tunnel)","x":1320,"y":-380,"width":360,"height":80,"color":"2"}
	],
